# ==============================================================================
# ProofReturn Environment Configuration Template (Section 35.1)
# Copy to .env and fill placeholders. Never commit real secrets.
# ==============================================================================

ENVIRONMENT=local
DEMO_MODE=true
DEMO_BOOTSTRAP_KEY=replace_with_at_least_32_bytes_random_hex_demo_bootstrap_key
DEMO_WEBHOOK_SECRET=replace_with_at_least_32_bytes_random_hex_demo_webhook_secret
MODE=judge
COMPOSE_PROFILE=lite
CALIBRATION_PROFILE=illustrative

# PayPal Sandbox (TM-16: PAYPAL_BASE_URL must be the Sandbox API host)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_sandbox_webhook_id
IDEMPOTENCY_REPLAY_WINDOW_DAYS=30

# AI Provider: Google Gemini (Free Tier supported) / Anthropic (Section 7.1, 35.1)
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
OPEN_VLM_URL=http://localhost:8001/v1
MODEL_CONFIG_PATH=config/models.yaml
# Infrastructure (PostgreSQL 16 + pgvector, Redis, MinIO)
POSTGRES_USER=proofreturn
POSTGRES_PASSWORD=proofreturn_dev_password
POSTGRES_DB=proofreturn
DATABASE_URL=postgresql+psycopg://proofreturn:proofreturn_dev_password@localhost:5432/proofreturn
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_secret

# Cryptography, Signing Keys & Privacy Salts (RV-01, AUD-28, INV-09, INV-13; >= 32 bytes required, distinct keys)
SIGNING_KEY_PATH=config/dev_signing_key.bin
AUTH_SIGNING_KEY=replace_with_at_least_32_bytes_random_hex_signing_key
PLATFORM_SIGNING_SEED_HEX=replace_with_64_char_hex_ed25519_seed
PACKER_SIGNING_SEED_HEX=replace_with_64_char_hex_ed25519_seed
SERIAL_HASH_SALT=replace_with_at_least_32_bytes_random_hex_salt
PAYER_HASH_SALT=replace_with_at_least_32_bytes_random_hex_salt
MEDIA_RETENTION_DAYS=90

# Operational Configuration (Section 8, FR-90)
CARRIER_EVENTS_MANUAL=true
